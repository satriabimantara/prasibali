msgstr "(i) Identifikasi tokoh"

msgid "F1 CV"
msgstr "F1 CV"

msgid "macro F1 test"
msgstr "F1 makro uji"

msgid "(ii) Alias clustering"
msgstr "(ii) Pengelompokan alias"

