# PrasiBali.ai: production environment for the Hostinger KVM 1 server (https://prasibali.tech).
# On the server this file is ~/prasibali/.env (chmod 600), created by deploy/server/init_env.sh.
# Secrets stay EMPTY here; fill them only in the server's .env. Never commit real values.
# Guide: docs/deploy_hostinger.md (step D2). Variable reference: docs/deploy.md (section 5).

# --- Django -------------------------------------------------------------------------------------
# Secret: random 64 hex chars, generated by init_env.sh (manually: openssl rand -hex 32).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=prasibali.tech,www.prasibali.tech
CSRF_TRUSTED_ORIGINS=https://prasibali.tech,https://www.prasibali.tech
DJANGO_LOG_LEVEL=INFO
# Optional, default True (keep it):
# DJANGO_SECURE_SSL_REDIRECT=True

# --- Caddy (HTTPS, Let's Encrypt) ---------------------------------------------------------------
SITE_DOMAIN=prasibali.tech
ACME_EMAIL=noreply@prasibali.tech

# --- PostgreSQL ---------------------------------------------------------------------------------
# DATABASE_URL is built by docker-compose.prod.yml from these three values; do not set it here.
POSTGRES_DB=prasibali
POSTGRES_USER=prasibali
# Secret: random hex, generated by init_env.sh (manually: openssl rand -hex 20).
# Do not change it after the first deploy: it is set when the database volume is created.
POSTGRES_PASSWORD=

# --- Email: Hostinger Email SMTP, mailbox noreply@prasibali.tech --------------------------------
# EMAIL_HOST, EMAIL_PORT, EMAIL_USE_TLS and EMAIL_USE_SSL already default to the values below; they are
# listed so the server file is explicit. Fallback if port 587 times out: EMAIL_PORT=465, EMAIL_USE_TLS=False,
# EMAIL_USE_SSL=True (never both True).
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=noreply@prasibali.tech
# Secret: password of the noreply@prasibali.tech mailbox (hPanel -> Emails -> Email accounts).
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="PrasiBali.ai <noreply@prasibali.tech>"
SERVER_EMAIL="PrasiBali.ai <noreply@prasibali.tech>"

# --- Judges' demo account (python manage.py create_demo_user) -----------------------------------
# Secret: chosen by you, sent to the committee through the official form only.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- Hostinger KVM 1 (1 vCPU, 4 GB RAM): measured in docs/deploy.md -----------------------------
GUNICORN_WORKERS=2
WEB_MEM_LIMIT=3500m
ANALYSIS_CLASSIFIER_CACHE_SIZE=2
ANALYSIS_DAILY_QUOTA=10
ANALYSIS_LOW_CONTEXT_WORDS=20

# --- AI models ----------------------------------------------------------------------------------
# PRETRAINED_MODELS_DIR, HF_HOME, BALINESE_NLP_WORK_DIR and ANALYSIS_WARM_ON_START are set by
# docker-compose.prod.yml; HF_HUB_OFFLINE=1 is set by docker/entrypoint.sh after warm_models.
# Empty = defaults (satriabimantara/balinese_pretrained_wordembedding, 300_fasttext_model.bin).
TF5_HF_REPO_ID=
TF5_FASTTEXT_FILENAME=
# Only if the Hugging Face embedding repo is private (secret); leave commented out otherwise:
# HF_TOKEN=

# --- Backups (docker/backup.sh) -----------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_AT=02:00
