# =============================================================
# PrasiBali.ai — contoh konfigurasi environment
# Salin menjadi `.env` lalu isi nilainya. JANGAN commit file .env.
# =============================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=ganti-dengan-string-acak-panjang
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_DOMAIN=localhost:8000
LANGUAGE_CODE=id

# --- Database (PostgreSQL) ---
POSTGRES_DB=prasibali
POSTGRES_USER=prasibali
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# atau satu baris: DATABASE_URL=postgres://user:password@db:5432/prasibali

# --- Email (verifikasi akun & reset password) ---
# Lokal: console backend (email tampil di log). Produksi: SMTP Gmail + App Password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PrasiBali.ai <no-reply@prasibali.ai>

# --- Aplikasi ---
ANALYSIS_DAILY_QUOTA=30
ANALYSIS_MAX_CHARS=20000

# --- Akun demo juri (dibuat dengan: python manage.py create_demo_user) ---
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- Superuser awal (opsional, untuk setup pertama) ---
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# -------- AI PRETRAINED MODEL
# classifier untuk model watak classification
CLASSIFIER_MODEL_PATH=
# Folder pretrained-models (berisi character-classification/ dan label-encoder/)
PRETRAINED_MODELS_DIR=
TF5_FASTTEXT_FILENAME=